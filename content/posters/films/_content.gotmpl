{{/* One page per film in data/posters/films.json (replaces generated Markdown). */}}
{{/* Display titles (batch 4): the title shown in San Vito, see partials/posters/titoli.html. */}}
{{ $titoli := partialCached "posters/titoli.html" . "titoli" }}
{{ range hugo.Data.posters.films.films }}
  {{/* Social image: the first printed poster, else the first poster. */}}
  {{ $params := dict "film_id" .film_id "generated" true }}
  {{ with where .posters "is_retro" false | default .posters }}
    {{ $params = merge $params (dict "image" (printf "/%s" (index . 0).large)) }}
  {{ end }}
  {{ $page := dict
    "path" .film_id
    "title" (index $titoli .film_id).titolo
    "kind" "page"
    "type" "posters"
    "layout" "film"
    "sitemap" (dict "priority" -1)
    "params" $params
  }}
  {{ $.AddPage $page }}
{{ end }}

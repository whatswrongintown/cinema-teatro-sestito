{{/* One section page per initial letter found in data/posters/films.json. */}}
{{ $letters := slice }}
{{ range site.Data.posters.films.films }}{{ $letters = $letters | append .letter }}{{ end }}
{{ range $letters | uniq }}
  {{ $slug := cond (eq . "#") "0-9" (lower .) }}
  {{ $page := dict
    "path" $slug
    "title" .
    "kind" "section"
    "type" "posters"
    "layout" "letter"
    "sitemap" (dict "priority" -1)
    "params" (dict "collection" "printed" "letter" . "generated" true)
  }}
  {{ $.AddPage $page }}
{{ end }}

{{/* One section page per initial letter of the display titles (partials/posters/titoli.html). */}}
{{ $letters := slice }}
{{ range partialCached "posters/titoli.html" . "titoli" }}{{ $letters = $letters | append .lettera }}{{ end }}
{{ range $letters | uniq }}
  {{ $slug := cond (eq . "#") "0-9" (lower .) }}
  {{ $page := dict
    "path" $slug
    "title" .
    "kind" "section"
    "type" "posters"
    "layout" "letter"
    "sitemap" (dict "priority" -1)
    "params" (dict "collection" "printed" "letter" . "generated" true)
  }}
  {{ $.AddPage $page }}
{{ end }}
